    },
    "You pay for more than you use. Some subscriptions may be worth canceling." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi più di quanto usi. Alcuni abbonamenti potrebbero valere la pena di essere disdetti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous payez plus que vous n'utilisez. Certains abonnements mériteraient peut-être d'être résiliés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du zahlst mehr, als du nutzt. Manche Abos könnten eine Kündigung wert sein."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt meer dan je gebruikt. Sommige abonnementen zijn het opzeggen misschien waard."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghs più di quants usi. Alcuns abbonaments potrebbers valers la pens di essers disdetts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagas más de lo que usas. Quizá valga la pena cancelar algunas suscripciones."
          }
        }
      }
    },
    "You use what you pay for and stay within budget." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usi quello che paghi e resti nel budget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous utilisez ce que vous payez et restez dans votre budget."
          }
        },
        "de" : {
          "stringUnit" : {
