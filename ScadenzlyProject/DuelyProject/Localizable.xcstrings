    "You could pay up to %@ less a month with cheaper plans or similar services." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potresti pagare fino a %@ in meno al mese con piani più economici o servizi simili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourriez payer jusqu'à %@ de moins par mois avec des formules moins chères ou des services similaires."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit günstigeren Tarifen oder ähnlichen Diensten könntest du bis zu %@ weniger pro Monat zahlen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met goedkopere abonnementen of vergelijkbare diensten kun je tot %@ per maand minder betalen."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
