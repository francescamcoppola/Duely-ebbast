    "Nice to meet you, %@. Set a monthly limit and we'll let you know when you're getting close." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piacere di conoscerti, %@. Imposta un limite mensile e ti avviseremo quando ti avvicini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravi de vous rencontrer, %@. Fixez une limite mensuelle et nous vous préviendrons quand vous en approchez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schön, dich kennenzulernen, %@. Lege ein monatliches Limit fest und wir sagen dir Bescheid, wenn du dich ihm näherst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leuk je te ontmoeten, %@. Stel een maandlimiet in en we laten het je weten als je in de buurt komt."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piacers di conoscerts, %@. Imposts un limits mensils e ti avviserems quands ti avvicins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encantados de conocerte, %@. Fija un límite mensual y te avisaremos cuando te acerques."
          }
        }
      }
    },
    "No budget set, so your profile can only use how often you use your subscriptions." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun budget impostato, quindi il tuo profilo può basarsi solo su quanto usi i tuoi abbonamenti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun budget défini : votre profil ne peut se baser que sur la fréquence d'utilisation de vos abonnements."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Budget festgelegt, daher kann dein Profil nur berücksichtigen, wie oft du deine Abos nutzt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen budget ingesteld, dus je profiel kan alleen kijken hoe vaak je je abonnementen gebruikt."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun budget impostats, quinds il tuo profils può basarss sols su quants usi i tuoi abbonaments."
          }
        },
        "es" : {
