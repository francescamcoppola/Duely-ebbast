    "%@'s use of information received from Google APIs adheres to the Google API Services User Data Policy, including the Limited Use requirements." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung von Informationen aus Google APIs durch %@ entspricht der Google API Services User Data Policy, einschließlich der Anforderungen zur eingeschränkten Nutzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El uso que hace %@ de la información recibida de las API de Google cumple la Política de datos de usuario de los servicios de API de Google, incluidos los requisitos de uso limitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilisation par %@ des informations reçues des API Google respecte le Règlement sur les données utilisateur des services API Google, y compris les exigences d'utilisation limitée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'uso delle informazioni ricevute dalle API di Google da parte di %@ rispetta le Norme sui dati utente dei servizi API di Google, inclusi i requisiti di uso limitato."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'uso dells informazions ricevuts dalls API di Google da parts di %@ rispetts le Norms sui dats utents dei servizs API di Google, incluss i requisits di uso limitats."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gebruik door %@ van informatie die van Google API's wordt ontvangen, voldoet aan het Google API Services User Data Policy, inclusief de vereisten voor beperkt gebruik."
          }
        }
      }
    },
    "%@'s website couldn't be found. If you subscribed through the App Store, cancel it from App Store Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website von %@ wurde nicht gefunden. Wenn du über den App Store abonniert hast, kündige über App Store-Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el sitio web de %@. Si te suscribiste a través del App Store, cancela desde Suscripciones del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site de %@ est introuvable. Si vous vous êtes abonné via l'App Store, résiliez depuis Abonnements App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile trovare il sito di %@. Se ti sei abbonato tramite l'App Store, disdici da Abbonamenti App Store."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stats possibils trovars il sits di %@. Se ti sei abbonats tramits l'App Store, disdics da Abbonaments App Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website van %@ is niet gevonden. Als je via de App Store hebt afgesloten, zeg dan op via App Store-abonnementen."
          }
        }
      }
    },
    "%@'s website doesn't link to it directly. Sign in there and look for your account or subscription settings. If you subscribed through the App Store, cancel it from App Store Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website von %@ verlinkt nicht direkt darauf. Melde dich dort an und suche die Konto- oder Abo-Einstellungen. Wenn du über den App Store abonniert hast, kündige über App Store-Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sitio web de %@ no enlaza directamente a ella. Inicia sesión allí y busca los ajustes de la cuenta o de la suscripción. Si te suscribiste a través del App Store, cancela desde Suscripciones del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site de %@ n'y renvoie pas directement. Connectez-vous et cherchez les réglages du compte ou de l'abonnement. Si vous vous êtes abonné via l'App Store, résiliez depuis Abonnements App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito di %@ non ha un link diretto. Accedi lì e cerca le impostazioni dell'account o dell'abbonamento. Se ti sei abbonato tramite l'App Store, disdici da Abbonamenti App Store."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sits di %@ non ha un link diretts. Acceds lì e cercs le impostazions dell'account o dell'abbonaments. Se ti sei abbonats tramits l'App Store, disdics da Abbonaments App Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website van %@ linkt er niet direct naar. Log daar in en zoek de account- of abonnementsinstellingen. Als je via de App Store hebt afgesloten, zeg dan op via App Store-abonnementen."
          }
        }
