    "Reading emails…" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leyendo correos…"
          }
        }
      }
    },
    "Recent billing emails are downloaded straight from Google to your device and read by Apple Intelligence on the device. Their content is never sent to %@, to Apple or to anyone else, isn't used to train models, and isn't saved after the scan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Rechnungs-E-Mails werden direkt von Google auf dein Gerät geladen und dort von Apple Intelligence gelesen. Ihr Inhalt wird nie an %@, Apple oder sonst jemanden gesendet, nicht zum Trainieren von Modellen genutzt und nach der Analyse nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los correos de facturación recientes se descargan directamente de Google a tu dispositivo y Apple Intelligence los lee en el propio dispositivo. Su contenido nunca se envía a %@, a Apple ni a nadie más, no se usa para entrenar modelos y no se guarda tras el análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails de facturation récents sont téléchargés directement de Google vers votre appareil et lus par Apple Intelligence sur l'appareil. Leur contenu n'est jamais envoyé à %@, à Apple ni à personne d'autre, n'est pas utilisé pour entraîner des modèles et n'est pas conservé après l'analyse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email di pagamento recenti vengono scaricate direttamente da Google sul tuo dispositivo e lette da Apple Intelligence sul dispositivo. Il loro contenuto non viene mai inviato a %@, ad Apple o a nessun altro, non viene usato per addestrare modelli e non viene salvato dopo l'analisi."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email di pagaments recents vengons scaricats direttaments da Google sul tuo dispositivs e letts da Apple Intelligence sul dispositivs. Il lors contenuts non viens mai inviats a %@, ad Apple o a nessun altrs, non viens usats per addestrars modells e non viens salvats dops l'analiss."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recente factuur-e-mails worden rechtstreeks van Google naar je apparaat gedownload en daar door Apple Intelligence gelezen. De inhoud wordt nooit naar %@, Apple of iemand anders gestuurd, niet gebruikt om modellen te trainen en na de scan niet bewaard."
          }
        }
      }
    },
