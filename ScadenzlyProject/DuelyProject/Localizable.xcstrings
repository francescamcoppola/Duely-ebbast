        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface tout et vous ramène à l'écran d'accueil pour configurer à nouveau %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alles und bringt dich zurück zum Willkommensbildschirm, um %@ neu einzurichten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist alles en brengt je terug naar het welkomstscherm om %@ opnieuw in te stellen."
