    "Deletes everything and takes you back to the welcome screen to set up %@ again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutto e ti riporta alla schermata di benvenuto per configurare di nuovo %@."
