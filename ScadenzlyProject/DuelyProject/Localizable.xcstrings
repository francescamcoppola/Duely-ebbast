{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ can only read email. It can't send, delete or change anything in your mailbox." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ solo puede leer el correo. No puede enviar, eliminar ni cambiar nada en tu buzón."
          }
        }
      }
    },
    "%@ doesn't track you, show ads or share data with data brokers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no te rastrea, no muestra anuncios ni comparte datos con intermediarios de datos."
          }
        }
      }
    },
    "%@ has no account, no servers and no analytics. Everything you enter stays on your device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no tiene cuentas, servidores ni analíticas. Todo lo que introduces se queda en tu dispositivo."
          }
        }
      }
    },
    "%@'s use of information received from Google APIs adheres to the Google API Services User Data Policy, including the Limited Use requirements." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El uso que hace %@ de la información recibida de las API de Google cumple la Política de datos de usuario de los servicios de API de Google, incluidos los requisitos de uso limitado."
          }
        }
      }
    },
    "^[%lld subscription](inflect: true) added." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "^[%lld suscripción agregada](inflect: true)."
          }
        }
      }
    },
    "Access to Gmail wasn't allowed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se permitió el acceso a Gmail."
          }
        }
      }
    },
    "Account" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuenta"
          }
        }
      }
    },
    "Allow “View your email messages and settings” on Google's screen so emails can be scanned." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite “Ver tus mensajes y ajustes de correo electrónico” en la pantalla de Google para poder analizar los correos."
          }
        }
      }
    },
    "Analyzed on this device" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Analizado en este dispositivo"
          }
        }
      }
    },
    "Apple Intelligence is still getting ready. Try again in a few minutes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence aún se está preparando. Vuelve a intentarlo en unos minutos."
          }
        }
      }
    },
    "Apple Intelligence isn't available right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence no está disponible en este momento."
          }
        }
      }
    },
    "Apple Intelligence reads your recent receipts and renewal emails on this device and suggests the subscriptions it finds. You choose which ones to add." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence lee en este dispositivo tus recibos y correos de renovación recientes y te sugiere las suscripciones que encuentra. Tú eliges cuáles agregar."
          }
        }
      }
    },
    "Billed in %@, saved without conversion" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Facturado en %@, se guarda sin conversión"
          }
        }
      }
    },
    "Check-in and payment reminders are scheduled on your device. No push service is used." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los recordatorios de revisión y de pago se programan en tu dispositivo. No se usa ningún servicio push."
          }
        }
      }
    },
    "Connect Gmail" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conectar Gmail"
          }
        }
      }
    },
    "Connected" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conectado"
          }
        }
      }
    },
    "Couldn't reach Google. Check your connection and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo conectar con Google. Revisa tu conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "Delete subscriptions in the app, disconnect Gmail in Settings, or delete the app to remove everything it stored." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina suscripciones en la app, desconecta Gmail en Configuración o elimina la app para borrar todo lo que guardó."
          }
        }
      }
    },
    "Delete your data" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eliminar tus datos"
          }
        }
      }
    },
    "Disconnect" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desconectar"
          }
        }
      }
    },
    "Disconnect Gmail" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desconectar Gmail"
          }
        }
      }
    },
    "Disconnect Gmail?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Desconectar Gmail?"
          }
        }
      }
    },
    "Emails are held in memory only during a scan. Only the subscriptions you choose to add are saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los correos solo se mantienen en memoria durante el análisis. Solo se guardan las suscripciones que decides agregar."
          }
        }
      }
    },
    "Emails are read by Apple Intelligence on your device. Their content is never sent to %@, to Apple or to anyone else." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence lee los correos en tu dispositivo. Su contenido nunca se envía a %@, a Apple ni a nadie más."
          }
        }
      }
    },
    "Find Subscriptions in Your Email" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encuentra suscripciones en tu correo"
          }
        }
      }
    },
    "Find subscriptions in your Gmail receipts with Apple Intelligence, on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encuentra suscripciones en tus recibos de Gmail con Apple Intelligence, en este dispositivo."
          }
        }
      }
    },
    "Found in Email" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encontradas en el correo"
          }
        }
      }
    },
    "Found on this device by Apple Intelligence, which can make mistakes. Check the details: you can edit any subscription after adding it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encontradas en este dispositivo por Apple Intelligence, que puede cometer errores. Revisa los detalles: puedes editar cualquier suscripción después de agregarla."
          }
        }
      }
    },
    "Gmail" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gmail"
          }
        }
      }
    },
    "Gmail import isn't available in this version of the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La importación desde Gmail no está disponible en esta versión de la app."
          }
        }
      }
    },
    "Gmail import isn't set up in this version of the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La importación desde Gmail no está configurada en esta versión de la app."
          }
        }
      }
    },
    "Google didn't complete the sign-in. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Google no completó el inicio de sesión. Vuelve a intentarlo."
          }
        }
      }
    },
    "If you connect Gmail, %@ asks Google for read-only access. It can't send, delete or change email." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si conectas Gmail, %@ pide a Google acceso de solo lectura. No puede enviar, eliminar ni cambiar correos."
          }
        }
      }
    },
    "Import from Email" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importar desde el correo"
          }
        }
      }
    },
    "Last scanned %@. Reads up to %lld recent billing emails." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Last scanned %1$@. Reads up to %2$lld recent billing emails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Último análisis: %1$@. Lee hasta %2$lld correos de facturación recientes."
          }
        }
      }
    },
    "Local notifications" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Notificaciones locales"
          }
        }
      }
    },
    "Next payment %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Próximo pago: %@"
          }
        }
      }
    },
    "No New Subscriptions" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suscripciones nuevas"
          }
        }
      }
    },
    "No price found · Needs setup" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sin precio · Requiere configuración"
          }
        }
      }
    },
    "No receipts or renewals were found for subscriptions that aren't in %@ yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se encontraron recibos ni renovaciones de suscripciones que aún no estén en %@."
