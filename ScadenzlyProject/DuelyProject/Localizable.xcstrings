    "Pick the app you use for %@. Screen Time only tells %@ on which days it was used for a few minutes, never what you did, and you'll be reminded if you stop opening it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick the app you use for %1$@. Screen Time only tells %2$@ on which days it was used for a few minutes, never what you did, and you'll be reminded if you stop opening it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'app che usi per %@. Tempo di utilizzo dice a %@ solo in quali giorni è stata usata per qualche minuto, mai cosa hai fatto, e riceverai un promemoria se smetti di aprirla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la app que usas para %@. Tiempo de uso solo le dice a %@ qué días se usó unos minutos, nunca qué hiciste, y recibirás un aviso si dejas de abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'app que vous utilisez pour %@. Temps d'écran indique seulement à %@ les jours où elle a été utilisée quelques minutes, jamais ce que vous avez fait, et vous serez prévenu si vous ne l'ouvrez plus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die App, die du für %@ nutzt. Bildschirmzeit teilt %@ nur mit, an welchen Tagen sie ein paar Minuten genutzt wurde, nie was du getan hast, und du wirst erinnert, wenn du sie nicht mehr öffnest."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de app die je voor %@ gebruikt. Schermtijd vertelt %@ alleen op welke dagen hij een paar minuten is gebruikt, nooit wat je deed, en je krijgt een herinnering als je hem niet meer opent."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegls l'app che usi per %@. Temps di utilizzs dics a %@ sols in quals giorns è stats usats per qualchs minuts, mai coss hai fatts, e ricevers un promemors se smetts di aprirls."
          }
        }
      }
    },
    "Pick up to %lld to get started. You can add more later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle bis zu %lld aus, um zu starten. Du kannst später weitere hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige hasta %lld para empezar. Podrás agregar más después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en jusqu'à %lld pour commencer. Vous pourrez en ajouter d'autres plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegline fino a %lld per iniziare. Potrai aggiungerne altri dopo."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglins fins a %lld per iniziars. Potrs aggiungerns altrs dops."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies er maximaal %lld om te beginnen. Je kunt er later meer toevoegen."
          }
        }
      }
    },
