    "For each Gmail account you connect, %@ asks Google for read-only access. It can't send, delete or change email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jeden verbundenen Gmail-Account bittet %@ Google um Lesezugriff. Es kann keine E-Mails senden, löschen oder ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por cada cuenta de Gmail que conectes, %@ pide a Google acceso de solo lectura. No puede enviar, eliminar ni cambiar correos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque compte Gmail connecté, %@ demande à Google un accès en lecture seule. Il ne peut pas envoyer, supprimer ni modifier d'e-mails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni account Gmail che colleghi, %@ chiede a Google l'accesso in sola lettura. Non può inviare, eliminare o modificare email."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogns account Gmail che colleghs, %@ chieds a Google l'accesss in sols letturs. Non può inviars, eliminars o modificars email."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor elk Gmail-account dat je koppelt, vraagt %@ Google om alleen-lezentoegang. Het kan geen e-mail versturen, verwijderen of wijzigen."
          }
        }
      }
    },
