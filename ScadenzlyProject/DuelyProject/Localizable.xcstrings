    "That's %@ a month. If this keeps happening, it may be worth canceling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind %@ pro Monat. Wenn das so bleibt, lohnt sich vielleicht eine Kündigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son %@ al mes. Si esto sigue así, quizá valga la pena cancelarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela fait %@ par mois. Si cela continue, il vaudrait peut-être mieux résilier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono %@ al mese. Se continua così, potrebbe valere la pena disdirlo."
          }
        },
