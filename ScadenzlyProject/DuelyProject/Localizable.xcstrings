    "Removes %@'s access in this Google Account and deletes the sign-in from this device. Subscriptions you've added stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt den Zugriff von %@ auf dieses Google-Konto und löscht die Anmeldung von diesem Gerät. Hinzugefügte Abos bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el acceso de %@ a esta cuenta de Google y elimina el inicio de sesión de este dispositivo. Las suscripciones que agregaste se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire l'accès de %@ à ce compte Google et supprime la connexion de cet appareil. Les abonnements ajoutés sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove l'accesso di %@ a questo Account Google ed elimina l'accesso da questo dispositivo. Gli abbonamenti che hai aggiunto restano."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovs l'accesss di %@ a quests Account Google ed elimins l'accesss da quests dispositivs. Gli abbonaments che hai aggiunts restans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekt de toegang van %@ tot dit Google-account in en verwijdert de aanmelding van dit apparaat. Abonnementen die je hebt toegevoegd blijven staan."
          }
        }
      }
    },
