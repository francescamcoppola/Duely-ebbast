    },
    "%@ renews in %lld days" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ renews in %#@days@"
          },
          "substitutions" : {
            "days" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg day"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg days"
                    }
                  },
                  "zero" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ se renueva en %#@days@"
          },
          "substitutions" : {
            "days" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg día"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg días"
                    }
                  },
                  "zero" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "%arg días"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ renews in a week" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se renueva en una semana"
          }
        }
      }
    },
    "%@ renews tomorrow" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se renueva mañana"
          }
        }
      }
