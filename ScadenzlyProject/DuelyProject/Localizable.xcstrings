    "%@ can only read email. It can't send, delete or change anything in your mailbox." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ solo puede leer el correo. No puede enviar, eliminar ni cambiar nada en tu buzón."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ può solo leggere le email. Non può inviare, eliminare o modificare nulla nella tua casella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut seulement lire les e-mails. Il ne peut rien envoyer, supprimer ni modifier dans votre boîte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann E-Mails nur lesen. Es kann in deinem Postfach nichts senden, löschen oder ändern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan alleen e-mail lezen. Het kan niets versturen, verwijderen of wijzigen in je mailbox."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ può sols leggers le email. Non può inviars, eliminars o modificars nulls nells tua casells."
          }
        }
      }
    },
    "%@ checks every receipt, renewal, bill, tax notice and tuition email of the last 13 months, skips ads, newsletters and repeats, and Apple Intelligence reads the rest on this device. Connect several accounts to find everything. You choose what to add." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ controlla ogni ricevuta, rinnovo, bolletta, avviso di tasse e email universitaria degli ultimi 13 mesi, salta pubblicità, newsletter e doppioni, e Apple Intelligence legge il resto su questo dispositivo. Collega più account per trovare tutto. Sei tu a scegliere cosa aggiungere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vérifie chaque reçu, renouvellement, facture, avis d'impôt et e-mail de frais de scolarité des 13 derniers mois, ignore publicités, newsletters et doublons, et Apple Intelligence lit le reste sur cet appareil. Connectez plusieurs comptes pour tout trouver. C'est vous qui choisissez quoi ajouter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prüft jeden Beleg, jede Verlängerung, Rechnung, Steuermitteilung und Studiengebühren-E-Mail der letzten 13 Monate, überspringt Werbung, Newsletter und Wiederholungen, und Apple Intelligence liest den Rest auf diesem Gerät. Verbinde mehrere Accounts, um alles zu finden. Du entscheidest, was hinzugefügt wird."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ controleert elk bonnetje, elke verlenging, rekening, belastingaanslag en collegegeld-e-mail van de afgelopen 13 maanden, slaat reclame, nieuwsbrieven en herhalingen over, en Apple Intelligence leest de rest op dit apparaat. Koppel meerdere accounts om alles te vinden. Jij kiest wat je toevoegt."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ controlls ogns ricevuts, rinnovs, bolletts, avviss di tasss e email universitars degls ultims 13 mess, salts pubblicits, newsletter e doppions, e Apple Intelligence leggs il rests su quests dispositivs. Collegs più account per trovars tutts. Sei tu a scegliers coss aggiungers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ revisa cada recibo, renovación, factura, aviso de impuestos y correo de matrícula de los últimos 13 meses, omite publicidad, newsletters y repeticiones, y Apple Intelligence lee el resto en este dispositivo. Conecta varias cuentas para encontrarlo todo. Tú eliges qué agregar."
          }
        }
      }
    },
    "%@ doesn't track you, show ads or share data with data brokers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no te rastrea, no muestra anuncios ni comparte datos con intermediarios de datos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ti traccia, non mostra pubblicità e non condivide dati con data broker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne vous suit pas, n'affiche pas de publicité et ne partage pas de données avec des courtiers en données."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verfolgt dich nicht, zeigt keine Werbung und teilt keine Daten mit Datenhändlern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ volgt je niet, toont geen advertenties en deelt geen gegevens met databrokers."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ti traccs, non mostrs pubblicits e non condivids dats con data broker."
          }
        }
      }
    },
    "%@ has no account, no servers and no analytics. Everything you enter stays on your device." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no tiene cuentas, servidores ni analíticas. Todo lo que introduces se queda en tu dispositivo."
          }
        }
      }
    },
    "%@ has no account, no servers and no analytics. Everything you enter stays on your devices and in your own private iCloud." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha account, server né statistiche. Tutto ciò che inserisci resta sui tuoi dispositivi e nel tuo iCloud privato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a ni compte, ni serveurs, ni statistiques. Tout ce que vous saisissez reste sur vos appareils et dans votre iCloud privé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat kein Konto, keine Server und keine Analysen. Alles, was du eingibst, bleibt auf deinen Geräten und in deiner privaten iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft geen account, geen servers en geen analyses. Alles wat je invoert blijft op je apparaten en in je eigen privé-iCloud."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha account, server né statistichs. Tutts ciò che inseriscs rests sui tuoi dispositivs e nel tuo iCloud privats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene cuenta, servidores ni análisis. Todo lo que introduces se queda en tus dispositivos y en tu propio iCloud privado."
          }
        }
      }
    },
    "%@ is managed in your Apple Account: Cancel Subscription opens your App Store subscriptions. %@ can't cancel for you; once it's cancelled, delete it here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is managed in your Apple Account: Cancel Subscription opens your App Store subscriptions. %2$@ can't cancel for you; once it's cancelled, delete it here."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si gestisce dal tuo Account Apple: Disdici abbonamento apre i tuoi abbonamenti App Store. %@ non può disdire al posto tuo; una volta disdetto, eliminalo qui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se gère dans votre compte Apple : Résilier l'abonnement ouvre vos abonnements App Store. %@ ne peut pas résilier à votre place ; une fois résilié, supprimez-le ici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird in deinem Apple Account verwaltet: „Abo kündigen“ öffnet deine App Store-Abos. %@ kann nicht für dich kündigen; lösche es hier, sobald es gekündigt ist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt beheerd in je Apple Account: 'Abonnement opzeggen' opent je App Store-abonnementen. %@ kan niet voor je opzeggen; verwijder het hier zodra het is opgezegd."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si gestiscs dal tuo Account Apple: Disdics abbonaments aprs i tuoi abbonaments App Store. %@ non può disdirs al posts tuo; una volts disdetts, eliminals qui."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se gestiona en tu cuenta de Apple: Cancelar suscripción abre tus suscripciones del App Store. %@ no puede cancelar por ti; cuando esté cancelada, elimínala aquí."
          }
        }
      }
    },
