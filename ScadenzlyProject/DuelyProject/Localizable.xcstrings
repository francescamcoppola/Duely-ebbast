    "Cheaper plans and similar services, based on typical prices. Features and content differ: check before switching." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piani più economici e servizi simili, in base ai prezzi tipici. Funzioni e contenuti cambiano: verifica prima di passare."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formules moins chères et services similaires, selon les prix habituels. Fonctionnalités et contenus diffèrent : vérifiez avant de changer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günstigere Tarife und ähnliche Dienste, basierend auf üblichen Preisen. Funktionen und Inhalte unterscheiden sich: Prüfe vor dem Wechsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goedkopere abonnementen en vergelijkbare diensten, op basis van gangbare prijzen. Functies en inhoud verschillen: controleer voordat je overstapt."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pians più economics e servizs simils, in bass ai prezzs tipics. Funzions e contenuts cambians: verifics prims di passars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planes más baratos y servicios similares, según precios habituales. Las funciones y el contenido varían: compruébalo antes de cambiar."
          }
        }
      }
    },
    "Check the name, or enter the price and billing cycle yourself." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il nome, oppure inserisci tu prezzo e ciclo di fatturazione."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le nom, ou saisissez vous-même le prix et le cycle de facturation."
          }
        },
        "de" : {
          "stringUnit" : {
