    "Cheaper plans and similar services, based on typical prices. Features and content differ: check before switching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günstigere Tarife und ähnliche Dienste, basierend auf üblichen Preisen. Funktionen und Inhalte unterscheiden sich: Prüfe vor dem Wechsel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planes más baratos y servicios similares, según precios habituales. Las funciones y el contenido varían: compruébalo antes de cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formules moins chères et services similaires, selon les prix habituels. Fonctionnalités et contenus diffèrent : vérifiez avant de changer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piani più economici e servizi simili, in base ai prezzi tipici. Funzioni e contenuti cambiano: verifica prima di passare."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pians più economics e servizs simils, in bass ai prezzs tipics. Funzions e contenuts cambians: verifics prims di passars."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goedkopere abonnementen en vergelijkbare diensten, op basis van gangbare prijzen. Functies en inhoud verschillen: controleer voordat je overstapt."
          }
        }
      }
    },
    "Check the name, or enter the price and billing cycle yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Namen oder gib Preis und Abrechnungszeitraum selbst ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el nombre o introduce tú el precio y el ciclo de facturación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le nom, ou saisissez vous-même le prix et le cycle de facturation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il nome, oppure inserisci tu prezzo e ciclo di fatturazione."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlls il noms, oppurs inseriscs tu prezzs e cicls di fatturazions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de naam of vul zelf de prijs en factureringsperiode in."
          }
        }
      }
    },
    "Check-In" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Revisión semanal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        }
      }
    },
    "Check-in and payment reminders are scheduled on your device. iCloud only uses silent notifications to tell the app your data changed on another device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in- und Zahlungserinnerungen werden auf deinem Gerät geplant. iCloud nutzt nur stille Mitteilungen, um der App zu melden, dass sich deine Daten auf einem anderen Gerät geändert haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de check-in y de pago se programan en tu dispositivo. iCloud solo usa notificaciones silenciosas para avisar a la app de que tus datos cambiaron en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels de check-in et de paiement sont programmés sur votre appareil. iCloud utilise seulement des notifications silencieuses pour signaler à l'app que vos données ont changé sur un autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria di check-in e pagamento sono programmati sul tuo dispositivo. iCloud usa solo notifiche silenziose per avvisare l'app che i dati sono cambiati su un altro dispositivo."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemors di check-in e pagaments sons programmats sul tuo dispositivs. iCloud usa sols notifichs silenzioss per avvisars l'app che i dats sons cambiats su un altrs dispositivs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen voor check-ins en betalingen worden op je apparaat ingepland. iCloud gebruikt alleen stille meldingen om de app te laten weten dat je gegevens op een ander apparaat zijn gewijzigd."
          }
        }
      }
    },
    "Check-in and payment reminders are scheduled on your device. No push service is used." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los recordatorios de revisión y de pago se programan en tu dispositivo. No se usa ningún servicio push."
          }
        }
      }
    },
