    "Delete subscriptions in the app, disconnect Gmail accounts in Settings, or reset %@ in Settings to erase everything from this device, iCloud and your other devices." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina gli abbonamenti nell'app, scollega gli account Gmail in Impostazioni, oppure reimposta %@ in Impostazioni per cancellare tutto da questo dispositivo, da iCloud e dagli altri tuoi dispositivi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez des abonnements dans l'app, déconnectez des comptes Gmail dans Réglages, ou réinitialisez %@ dans Réglages pour tout effacer de cet appareil, d'iCloud et de vos autres appareils."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche Abos in der App, trenne Gmail-Accounts in den Einstellungen oder setze %@ in den Einstellungen zurück, um alles von diesem Gerät, aus iCloud und von deinen anderen Geräten zu löschen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder abonnementen in de app, ontkoppel Gmail-accounts in Instellingen of stel %@ opnieuw in via Instellingen om alles te wissen van dit apparaat, uit iCloud en van je andere apparaten."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimins gli abbonaments nell'app, scollegs gli account Gmail in Impostazions, oppurs reimposts %@ in Impostazions per cancellars tutts da quests dispositivs, da iCloud e dagls altrs tuoi dispositivs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina suscripciones en la app, desconecta cuentas de Gmail en Ajustes o restablece %@ en Ajustes para borrarlo todo de este dispositivo, de iCloud y de tus otros dispositivos."
          }
        }
      }
    },
    "Delete subscriptions in the app, disconnect Gmail in Settings, or delete the app to remove everything it stored." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina suscripciones en la app, desconecta Gmail en Configuración o elimina la app para borrar todo lo que guardó."
          }
        }
      }
    },
