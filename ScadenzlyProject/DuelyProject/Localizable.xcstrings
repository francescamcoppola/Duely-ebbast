            "value" : "Abo kündigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar suscripción"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilier l'abonnement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdici abbonamento"
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdics abbonaments"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement opzeggen"
          }
        }
      }
    },
    "Cancel Subscription opens %@'s own cancellation page; you may need to sign in first. If you subscribed through the App Store, use App Store Subscriptions instead. %@ can't cancel for you; once it's cancelled, delete it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Abo kündigen“ öffnet die Kündigungsseite von %@; eventuell musst du dich zuerst anmelden. Wenn du über den App Store abonniert hast, nutze stattdessen App Store-Abos. %@ kann nicht für dich kündigen; lösche es hier, sobald es gekündigt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cancel Subscription opens %1$@'s own cancellation page; you may need to sign in first. If you subscribed through the App Store, use App Store Subscriptions instead. %2$@ can't cancel for you; once it's cancelled, delete it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar suscripción abre la página de cancelación de %@; puede que primero tengas que iniciar sesión. Si te suscribiste a través del App Store, usa Suscripciones del App Store. %@ no puede cancelar por ti; cuando esté cancelada, elimínala aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilier l'abonnement ouvre la page de résiliation de %@ ; vous devrez peut-être d'abord vous connecter. Si vous vous êtes abonné via l'App Store, utilisez plutôt Abonnements App Store. %@ ne peut pas résilier à votre place ; une fois résilié, supprimez-le ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdici abbonamento apre la pagina di disdetta di %@; potrebbe servire prima l'accesso. Se ti sei abbonato tramite l'App Store, usa Abbonamenti App Store. %@ non può disdire al posto tuo; una volta disdetto, eliminalo qui."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdics abbonaments aprs la pagins di disdetts di %@; potrebbs servirs prims l'accesss. Se ti sei abbonats tramits l'App Store, usa Abbonaments App Store. %@ non può disdirs al posts tuo; una volts disdetts, eliminals qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Abonnement opzeggen' opent de opzegpagina van %@; mogelijk moet je eerst inloggen. Als je via de App Store hebt afgesloten, gebruik dan App Store-abonnementen. %@ kan niet voor je opzeggen; verwijder het hier zodra het is opgezegd."
          }
        }
      }
    },
    "Cancel Subscription opens the service's own cancellation page. Delete only removes it from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Abo kündigen“ öffnet die Kündigungsseite des Dienstes. „Löschen“ entfernt es nur aus %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar suscripción abre la página de cancelación del servicio. Eliminar solo la quita de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilier l'abonnement ouvre la page de résiliation du service. Supprimer le retire seulement de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdici abbonamento apre la pagina di disdetta del servizio. Elimina lo toglie solo da %@."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdics abbonaments aprs la pagins di disdetts del servizs. Elimins lo togls sols da %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Abonnement opzeggen' opent de opzegpagina van de dienst. 'Verwijder' haalt het alleen uit %@."
          }
        }
      }
    },
    "Canceling %@ would save %@ a month and make you %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du %@ kündigst, sparst du %@ pro Monat und wärst %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Canceling %1$@ would save %2$@ a month and make you %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar %1$@ te ahorraría %2$@ al mes y te llevaría al perfil %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilier %@ vous ferait économiser %@ par mois et vous rendrait %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdire %@ ti farebbe risparmiare %@ al mese e diventeresti %@."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disdirs %@ ti farebbs risparmiars %@ al mess e diventerests %@."
          }
        },
        "nl" : {
