    },
    "%@'s website doesn't link to it directly. Sign in there and look for your account or subscription settings. If you subscribed through the App Store, cancel it from App Store Subscriptions." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito di %@ non ha un link diretto. Accedi lì e cerca le impostazioni dell'account o dell'abbonamento. Se ti sei abbonato tramite l'App Store, disdici da Abbonamenti App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site de %@ n'y renvoie pas directement. Connectez-vous et cherchez les réglages du compte ou de l'abonnement. Si vous vous êtes abonné via l'App Store, résiliez depuis Abonnements App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website von %@ verlinkt nicht direkt darauf. Melde dich dort an und suche die Konto- oder Abo-Einstellungen. Wenn du über den App Store abonniert hast, kündige über App Store-Abos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website van %@ linkt er niet direct naar. Log daar in en zoek de account- of abonnementsinstellingen. Als je via de App Store hebt afgesloten, zeg dan op via App Store-abonnementen."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sits di %@ non ha un link diretts. Acceds lì e cercs le impostazions dell'account o dell'abbonaments. Se ti sei abbonats tramits l'App Store, disdics da Abbonaments App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sitio web de %@ no enlaza directamente a ella. Inicia sesión allí y busca los ajustes de la cuenta o de la suscripción. Si te suscribiste a través del App Store, cancela desde Suscripciones del App Store."
          }
        }
      }
    },
