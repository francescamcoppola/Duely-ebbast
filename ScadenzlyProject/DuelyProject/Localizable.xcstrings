          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Gmail y Apple Intelligence encontrará tus suscripciones, facturas e impuestos en tus recibos, en este dispositivo. Tú eliges qué agregar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Gmail et Apple Intelligence trouvera vos abonnements, factures et impôts dans vos reçus, sur cet appareil. C'est vous qui choisissez quoi ajouter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Gmail und Apple Intelligence findet deine Abos, Rechnungen und Steuern in deinen Belegen, auf diesem Gerät. Du entscheidest, was hinzugefügt wird."
          }
        },
        "nl" : {
          "stringUnit" : {
