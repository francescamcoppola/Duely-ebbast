    "Subscriptions, check-ins and settings are saved in your private iCloud and stay in sync on all your devices signed in with the same Apple Account." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbonamenti, check-in e impostazioni sono salvati nel tuo iCloud privato e restano sincronizzati su tutti i dispositivi collegati allo stesso Account Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements, check-ins et réglages sont enregistrés dans votre iCloud privé et restent synchronisés sur tous vos appareils connectés au même compte Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos, Check-ins und Einstellungen werden in deiner privaten iCloud gespeichert und bleiben auf allen Geräten mit demselben Apple Account synchron."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen, check-ins en instellingen worden in je privé-iCloud bewaard en blijven gesynchroniseerd op al je apparaten met hetzelfde Apple Account."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbonaments, check-in e impostazions sons salvats nel tuo iCloud privats e restans sincronizzats su tutts i dispositivs collegats alls stesss Account Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones, los check-ins y los ajustes se guardan en tu iCloud privado y se mantienen sincronizados en todos tus dispositivos con la misma cuenta de Apple."
          }
        }
      }
    },
