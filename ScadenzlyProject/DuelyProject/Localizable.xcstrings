    "Found on this device by Apple Intelligence, which can make mistakes. Check the details: you can edit any subscription after adding it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encontradas en este dispositivo por Apple Intelligence, que puede cometer errores. Revisa los detalles: puedes editar cualquier suscripción después de agregarla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovati su questo dispositivo da Apple Intelligence, che può sbagliare. Controlla i dettagli: puoi modificare ogni abbonamento dopo averlo aggiunto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvés sur cet appareil par Apple Intelligence, qui peut se tromper. Vérifiez les détails : vous pourrez modifier chaque abonnement après l'avoir ajouté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät von Apple Intelligence gefunden, das sich irren kann. Prüfe die Details: Du kannst jedes Abo nach dem Hinzufügen bearbeiten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op dit apparaat gevonden door Apple Intelligence, dat fouten kan maken. Controleer de details: je kunt elk abonnement na het toevoegen wijzigen."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovats su quests dispositivs da Apple Intelligence, che può sbagliars. Controlls i dettagls: puoi modificars ogns abbonaments dops averls aggiunts."
          }
        }
      }
    },
