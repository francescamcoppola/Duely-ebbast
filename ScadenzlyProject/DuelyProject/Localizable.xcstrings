    "One quick question a week about which subscriptions you used. It makes your spending profile and usage insights more accurate." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una domanda veloce a settimana su quali abbonamenti hai usato. Rende più precisi il tuo profilo di spesa e gli approfondimenti sull'uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une question rapide par semaine sur les abonnements que vous avez utilisés. Elle rend votre profil de dépenses et vos analyses d'utilisation plus précis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Frage pro Woche, welche Abos du genutzt hast. Sie macht dein Ausgabenprofil und deine Nutzungseinblicke genauer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén korte vraag per week over welke abonnementen je hebt gebruikt. Zo worden je uitgavenprofiel en gebruiksinzichten nauwkeuriger."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una domands velocs a settimans su quals abbonaments hai usats. Rends più preciss il tuo profils di spess e gli approfondiments sull'uso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
