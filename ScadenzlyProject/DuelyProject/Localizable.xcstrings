          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is %@ per maand. Als dit zo blijft, is opzeggen misschien de moeite waard."
          }
        }
      }
    },
    "The connection dropped after %lld of %lld emails. What was found so far is shown; scan again to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung ist nach %lld von %lld E-Mails abgebrochen. Bisher Gefundenes wird angezeigt; analysiere erneut, um fertig zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó tras %lld de %lld correos. Se muestra lo encontrado hasta ahora; analiza de nuevo para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été interrompue après %lld e-mails sur %lld. Ce qui a été trouvé jusqu'ici est affiché ; relancez l'analyse pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta dopo %lld email su %lld. Vedi quello che è stato trovato finora; analizza di nuovo per completare."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessions si è interrotts dops %lld email su %lld. Veds quells che è stats trovats finors; analizzs di nuovs per completars."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding viel weg na %lld van %lld e-mails. Wat tot nu toe is gevonden wordt getoond; scan opnieuw om af te ronden."
          }
        }
      }
    },
    "The Gmail sign-in is kept in this device's Keychain and isn't synced. Disconnecting revokes it in your Google Account and deletes it." : {
