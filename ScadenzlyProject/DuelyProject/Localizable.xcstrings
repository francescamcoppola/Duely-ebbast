    "Emails are held in memory only during a scan. Ads and newsletters are skipped from their sender and subject, without being opened. Only the payments you choose to add are saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails bleiben nur während der Analyse im Speicher. Werbung und Newsletter werden anhand von Absender und Betreff übersprungen, ohne sie zu öffnen. Gespeichert werden nur die Zahlungen, die du hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos solo se mantienen en memoria durante el análisis. La publicidad y las newsletters se omiten por remitente y asunto, sin abrirlas. Solo se guardan los pagos que eliges agregar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails restent en mémoire uniquement pendant l'analyse. Publicités et newsletters sont ignorées d'après l'expéditeur et l'objet, sans être ouvertes. Seuls les paiements que vous choisissez d'ajouter sont enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email restano in memoria solo durante l'analisi. Pubblicità e newsletter vengono saltate in base a mittente e oggetto, senza aprirle. Vengono salvati solo i pagamenti che scegli di aggiungere."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email restans in memors sols durants l'analiss. Pubblicits e newsletter vengons saltats in bass a mittents e oggetts, senzs aprirls. Vengons salvats sols i pagaments che scegls di aggiungers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails blijven alleen tijdens een scan in het geheugen. Reclame en nieuwsbrieven worden op basis van afzender en onderwerp overgeslagen, zonder ze te openen. Alleen de betalingen die je toevoegt worden bewaard."
          }
        }
      }
    },
    "Emails are held in memory only during a scan. Only the subscriptions you choose to add are saved." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los correos solo se mantienen en memoria durante el análisis. Solo se guardan las suscripciones que decides agregar."
          }
        }
      }
    },
    "Emails are read by Apple Intelligence on your device. Their content is never sent to %@, to Apple or to anyone else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails werden von Apple Intelligence auf deinem Gerät gelesen. Ihr Inhalt wird nie an %@, Apple oder sonst jemanden gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence lee los correos en tu dispositivo. Su contenido nunca se envía a %@, a Apple ni a nadie más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails sont lus par Apple Intelligence sur votre appareil. Leur contenu n'est jamais envoyé à %@, à Apple ni à personne d'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email vengono lette da Apple Intelligence sul tuo dispositivo. Il loro contenuto non viene mai inviato a %@, ad Apple o a nessun altro."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email vengons letts da Apple Intelligence sul tuo dispositivs. Il lors contenuts non viens mai inviats a %@, ad Apple o a nessun altrs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails worden door Apple Intelligence op je apparaat gelezen. De inhoud wordt nooit naar %@, Apple of iemand anders gestuurd."
          }
        }
      }
    },
    "Erase All and Start Over" : {
