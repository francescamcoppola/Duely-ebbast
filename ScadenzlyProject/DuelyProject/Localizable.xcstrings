    "Check-in and payment reminders are scheduled on your device. iCloud only uses silent notifications to tell the app your data changed on another device." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria di check-in e pagamento sono programmati sul tuo dispositivo. iCloud usa solo notifiche silenziose per avvisare l'app che i dati sono cambiati su un altro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels de check-in et de paiement sont programmés sur votre appareil. iCloud utilise seulement des notifications silencieuses pour signaler à l'app que vos données ont changé sur un autre appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in- und Zahlungserinnerungen werden auf deinem Gerät geplant. iCloud nutzt nur stille Mitteilungen, um der App zu melden, dass sich deine Daten auf einem anderen Gerät geändert haben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen voor check-ins en betalingen worden op je apparaat ingepland. iCloud gebruikt alleen stille meldingen om de app te laten weten dat je gegevens op een ander apparaat zijn gewijzigd."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemors di check-in e pagaments sons programmats sul tuo dispositivs. iCloud usa sols notifichs silenzioss per avvisars l'app che i dats sons cambiats su un altrs dispositivs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de check-in y de pago se programan en tu dispositivo. iCloud solo usa notificaciones silenciosas para avisar a la app de que tus datos cambiaron en otro dispositivo."
          }
        }
      }
    },
    "Check-in and payment reminders are scheduled on your device. No push service is used." : {
      "extractionState" : "stale",
