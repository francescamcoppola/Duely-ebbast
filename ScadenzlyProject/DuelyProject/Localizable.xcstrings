    "Last scanned %@: checked ^[%lld email](inflect: true), skipped %lld ads and other non-billing emails and %lld repeats, read %lld with Apple Intelligence." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Last scanned %1$@: checked ^[%2$lld email](inflect: true), skipped %3$lld ads and other non-billing emails and %4$lld repeats, read %5$lld with Apple Intelligence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultima analisi %@: controllate ^[%lld email](inflect: true), saltate %lld pubblicità e altre email non di pagamento e %lld doppioni, lette %lld con Apple Intelligence."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dernière analyse %@ : ^[%lld e-mail](inflect: true) vérifiés, %lld publicités et autres e-mails hors facturation et %lld doublons ignorés, %lld lus avec Apple Intelligence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt analysiert %@: ^[%lld E-Mail](inflect: true) geprüft, %lld Werbe- und andere Nicht-Rechnungs-E-Mails und %lld Wiederholungen übersprungen, %lld mit Apple Intelligence gelesen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laatste scan %@: %lld e-mail(s) gecontroleerd, %lld reclame- en andere niet-factuur-e-mails en %lld herhalingen overgeslagen, %lld gelezen met Apple Intelligence."
          }
        },
        "it-VA" : {
          "stringUnit" : {
