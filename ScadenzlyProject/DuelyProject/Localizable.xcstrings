        }
      }
    },
    "No tracking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sin rastreo"
          }
        }
      }
    },
    "Nothing is kept" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se guarda nada"
          }
        }
      }
    },
    "Off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No"
          }
        }
      }
    },
    "On this device only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo en este dispositivo"
          }
        }
      }
    },
    "Optional and read-only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opcional y de solo lectura"
          }
        }
      }
    },
    "Privacy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Privacidad"
          }
        }
      }
    },
    "Processed on this device" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Procesado en este dispositivo"
          }
        }
      }
    },
    "Read-only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo lectura"
          }
        }
      }
    },
    "Reading emails…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leyendo correos…"
          }
        }
      }
    },
    "Reads up to %lld recent billing emails. Keep the app open while it runs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lee hasta %lld correos de facturación recientes. Mantén la app abierta mientras se ejecuta."
          }
        }
      }
    },
    "Recent billing emails are downloaded straight from Google to your device and read by Apple Intelligence on the device. Their content is never sent to %@, to Apple or to anyone else, isn't used to train models, and isn't saved after the scan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los correos de facturación recientes se descargan directamente de Google a tu dispositivo y Apple Intelligence los lee en el propio dispositivo. Su contenido nunca se envía a %@, a Apple ni a nadie más, no se usa para entrenar modelos y no se guarda tras el análisis."
          }
        }
      }
    },
    "Removes %@'s access in your Google Account and deletes the sign-in from this device. Subscriptions you've added stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retira el acceso de %@ en tu cuenta de Google y elimina el inicio de sesión de este dispositivo. Las suscripciones que agregaste se mantienen."
          }
        }
      }
    },
    "Scan" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Análisis"
          }
        }
      }
    },
    "Scan Emails" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Analizar correos"
          }
        }
      }
    },
    "Scanning emails needs a device that supports Apple Intelligence." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para analizar correos se necesita un dispositivo compatible con Apple Intelligence."
          }
        }
      }
    },
    "Searching your inbox…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buscando en tu bandeja de entrada…"
          }
        }
      }
    },
    "Something went wrong. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algo salió mal. Vuelve a intentarlo."
          }
        }
      }
    },
    "Stop Scanning" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener análisis"
          }
        }
      }
    },
    "Stored securely" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guardado de forma segura"
          }
        }
      }
    },
    "The Gmail sign-in is kept in this device's Keychain and isn't synced. Disconnecting revokes it in your Google Account and deletes it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El inicio de sesión de Gmail se guarda en el llavero de este dispositivo y no se sincroniza. Al desconectarlo, se revoca en tu cuenta de Google y se elimina."
          }
        }
      }
    },
    "The sign-in is stored in this device's Keychain. Disconnect at any time here or in your Google Account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El inicio de sesión se guarda en el llavero de este dispositivo. Desconéctalo cuando quieras aquí o en tu cuenta de Google."
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings › Apple Intelligence & Siri to scan emails." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Activa Apple Intelligence en Configuración › Apple Intelligence y Siri para analizar correos."
          }
        }
      }
    },
    "What's Stored" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qué se guarda"
          }
        }
      }
    },
    "You'll sign in on Google's page. %@ never sees your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Iniciarás sesión en la página de Google. %@ nunca ve tu contraseña."
          }
        }
      }
    },
    "Your choice" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tú decides"
          }
        }
      }
    },
    "Your Gmail connection expired. Connect again to continue." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu conexión con Gmail caducó. Vuelve a conectarla para continuar."
          }
        }
      }
    },
    "Your name, budget, currency, subscriptions and check-in answers are saved in the app's storage on this device. They're included in your device backup like other app data." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu nombre, presupuesto, moneda, suscripciones y respuestas de revisión se guardan en el almacenamiento de la app en este dispositivo. Se incluyen en la copia de seguridad del dispositivo como otros datos de apps."
          }
        }
      }
    },
    "Your Privacy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu privacidad"
          }
        }
      }
    },
