    "Emails are held in memory only during a scan. Ads and newsletters are skipped from their sender and subject, without being opened. Only what you choose to add is saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails bleiben nur während der Suche im Speicher. Werbung und Newsletter werden anhand von Absender und Betreff übersprungen, ohne sie zu öffnen. Gespeichert wird nur, was du hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos solo se guardan en memoria durante el análisis. Los anuncios y boletines se omiten por remitente y asunto, sin abrirlos. Solo se guarda lo que eliges añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails restent en mémoire seulement pendant l'analyse. Publicités et newsletters sont ignorées d'après l'expéditeur et l'objet, sans être ouvertes. Seul ce que vous choisissez d'ajouter est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email restano in memoria solo durante la ricerca. Pubblicità e newsletter vengono saltate in base a mittente e oggetto, senza aprirle. Viene salvato solo ciò che scegli di aggiungere."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email restans in memoris sols durants la ricercs. Pubblicità e newsletter vengons saltats in bass a mittents e oggetts, senzs aprirls. Viens salvats sols ciò che scegls di aggiungers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails blijven alleen tijdens de scan in het geheugen. Advertenties en nieuwsbrieven worden op afzender en onderwerp overgeslagen, zonder ze te openen. Alleen wat je kiest toe te voegen wordt bewaard."
          }
        }
      }
    },
    "Emails are held in memory only during a scan. Only the subscriptions you choose to add are saved." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los correos solo se mantienen en memoria durante el análisis. Solo se guardan las suscripciones que decides agregar."
          }
        }
      }
    },
    "Emails are read by Apple Intelligence on your device. Their content is never sent to %@, to Apple or to anyone else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails werden von Apple Intelligence auf deinem Gerät gelesen. Ihr Inhalt wird nie an %@, Apple oder sonst jemanden gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Intelligence lee los correos en tu dispositivo. Su contenido nunca se envía a %@, a Apple ni a nadie más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails sont lus par Apple Intelligence sur votre appareil. Leur contenu n'est jamais envoyé à %@, à Apple ni à personne d'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email vengono lette da Apple Intelligence sul tuo dispositivo. Il loro contenuto non viene mai inviato a %@, ad Apple o a nessun altro."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email vengons letts da Apple Intelligence sul tuo dispositivs. Il lors contenuts non viens mai inviats a %@, ad Apple o a nessun altrs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails worden door Apple Intelligence op je apparaat gelezen. De inhoud wordt nooit naar %@, Apple of iemand anders gestuurd."
          }
        }
      }
    },
