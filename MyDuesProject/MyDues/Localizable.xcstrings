      }
    },
    "The connection dropped after %lld of %lld emails. What was found so far is shown; scan again to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung ist nach %lld von %lld E-Mails abgebrochen. Bisher Gefundenes wird angezeigt; analysiere erneut, um fertig zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó tras %lld de %lld correos. Se muestra lo encontrado hasta ahora; analiza de nuevo para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été interrompue après %lld e-mails sur %lld. Ce qui a été trouvé jusqu'ici est affiché ; relancez l'analyse pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta dopo %lld email su %lld. Vedi quello che è stato trovato finora; analizza di nuovo per completare."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
