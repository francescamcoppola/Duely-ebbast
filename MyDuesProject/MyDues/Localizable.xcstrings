    "Connect Gmail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail verbinden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conectar Gmail"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecter Gmail"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega Gmail"
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegs Gmail"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail koppelen"
          }
        }
      }
    },
    "Connect Gmail and Apple Intelligence will find your subscriptions and free trials, bills and taxes, orders you can return, warranties and pagoPA notices, on this device. You choose what to add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Gmail, und Apple Intelligence findet auf diesem Gerät deine Abos und Gratis-Testphasen, Rechnungen und Steuern, zurücksendbare Bestellungen, Garantien und pagoPA-Zahlungsaufforderungen. Du entscheidest, was hinzugefügt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Gmail y Apple Intelligence encontrará tus suscripciones y pruebas gratuitas, facturas e impuestos, pedidos que puedes devolver, garantías y avisos pagoPA, en este dispositivo. Tú eliges qué añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Gmail et Apple Intelligence trouvera vos abonnements et essais gratuits, factures et impôts, commandes à retourner, garanties et avis pagoPA, sur cet appareil. Vous choisissez quoi ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega Gmail e Apple Intelligence troverà abbonamenti e prove gratuite, bollette e tasse, ordini da restituire, garanzie e avvisi pagoPA, su questo dispositivo. Sei tu a scegliere cosa aggiungere."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegs Gmail e Apple Intelligence troverà abbonaments e provs gratuits, bolletts e tasss, ordins da restituirs, garanzis e avviss pagoPA, su quests dispositivs. Sei tu a scegliers coss aggiungers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel Gmail en Apple Intelligence vindt op dit apparaat je abonnementen en proefperiodes, rekeningen en belastingen, bestellingen die je kunt retourneren, garanties en pagoPA-betaalberichten. Jij kiest wat je toevoegt."
          }
        }
      }
    },
