          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás un aviso antes de que termine el plazo de devolución. Las compras desde %@ también tendrán un aviso antes de que acabe la garantía de 2 años."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel arrive avant la fin du délai de retour. Les achats à partir de %@ ont aussi un rappel avant la fin de la garantie de 2 ans."
