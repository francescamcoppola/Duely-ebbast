    "Orders you can still return, warranties, free trials and pagoPA notices appear here. Add them by hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Bestellungen, die du noch zurücksenden kannst, Garantien, Gratis-Testphasen und pagoPA-Zahlungsaufforderungen. Füge sie manuell hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los pedidos que aún puedes devolver, las garantías, las pruebas gratuitas y los avisos pagoPA. Añádelos a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes encore retournables, les garanties, les essais gratuits et les avis pagoPA apparaissent ici. Ajoutez-les à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovi gli ordini che puoi ancora restituire, le garanzie, le prove gratuite e gli avvisi pagoPA. Aggiungili a mano."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovs gli ordins che puos ancors restituirs, le garanzis, le provs gratuits e gli avviss pagoPA. Aggiungils a mans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier verschijnen bestellingen die je nog kunt retourneren, garanties, gratis proefperiodes en pagoPA-betaalberichten. Voeg ze handmatig toe."
          }
        }
      }
    },
    "Orders you can still return, warranties, free trials and pagoPA notices appear here. Scan your email in Settings, or add them by hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Bestellungen, die du noch zurücksenden kannst, Garantien, Gratis-Testphasen und pagoPA-Zahlungsaufforderungen. Durchsuche deine E-Mails in den Einstellungen oder füge sie manuell hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los pedidos que aún puedes devolver, las garantías, las pruebas gratuitas y los avisos pagoPA. Busca en tu correo desde Ajustes o añádelos a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes encore retournables, les garanties, les essais gratuits et les avis pagoPA apparaissent ici. Analysez vos e-mails dans Réglages ou ajoutez-les à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovi gli ordini che puoi ancora restituire, le garanzie, le prove gratuite e gli avvisi pagoPA. Cercali nella tua email dalle Impostazioni o aggiungili a mano."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovs gli ordins che puos ancors restituirs, le garanzis, le provs gratuits e gli avviss pagoPA. Cercals nells tua email dalls Impostazions o aggiungils a mans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier verschijnen bestellingen die je nog kunt retourneren, garanties, gratis proefperiodes en pagoPA-betaalberichten. Scan je e-mail in Instellingen of voeg ze handmatig toe."
          }
