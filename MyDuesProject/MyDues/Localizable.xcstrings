    "Open %@ to let Apple Intelligence read them: iOS doesn't allow it while the app is in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne %@, damit Apple Intelligence sie liest: iOS erlaubt das nicht, solange die App im Hintergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre %@ para que Apple Intelligence los lea: iOS no lo permite con la app en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez %@ pour qu'Apple Intelligence les lise : iOS ne le permet pas quand l'app est en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri %@ per farle leggere ad Apple Intelligence: iOS non lo permette con l'app in background."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprs %@ per farls leggers ad Apple Intelligence: iOS non lo permetts con l'app in background."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open %@ zodat Apple Intelligence ze kan lezen: iOS staat dat niet toe als de app op de achtergrond staat."
          }
        }
      }
    },
