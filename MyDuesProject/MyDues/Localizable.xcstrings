    "Pay with pagoPA opens pagoPA's official site with the notice's codes. You pay there: %@ never sees your card or bank details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mit pagoPA bezahlen“ öffnet die offizielle pagoPA-Seite mit den Codes. Du bezahlst dort: %@ sieht nie deine Karten- oder Bankdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar con pagoPA abre el sitio oficial de pagoPA con los códigos del aviso. Pagas allí: %@ nunca ve los datos de tu tarjeta ni de tu banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer avec pagoPA ouvre le site officiel de pagoPA avec les codes de l'avis. Vous payez là-bas : %@ ne voit jamais votre carte ni vos coordonnées bancaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga con pagoPA apre il sito ufficiale pagoPA con i codici dell'avviso. Paghi lì: %@ non vede mai i dati della tua carta o del tuo conto."
          }
        },
        "it-VA" : {
