    "All payments are done. It no longer counts toward your totals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Zahlungen sind erledigt. Es zählt nicht mehr zu deinen Summen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los pagos están hechos. Ya no cuenta en tus totales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les paiements sont effectués. Il ne compte plus dans vos totaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i pagamenti sono stati fatti. Non conta più nei tuoi totali."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
