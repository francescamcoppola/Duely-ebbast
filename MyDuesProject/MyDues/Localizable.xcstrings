    "Amazon: 30 days from delivery, until 31 January for orders placed in November and December. Other stores: at least 14 days, the EU right of withdrawal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon: 30 Tage ab Lieferung, bis 31. Januar für Bestellungen im November und Dezember. Andere Shops: mindestens 14 Tage, das EU-Widerrufsrecht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon: 30 días desde la entrega, hasta el 31 de enero para pedidos de noviembre y diciembre. Otras tiendas: al menos 14 días, el derecho de desistimiento de la UE."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon : 30 jours après la livraison, jusqu'au 31 janvier pour les commandes de novembre et décembre. Autres boutiques : au moins 14 jours, le droit de rétractation de l'UE."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon: 30 giorni dalla consegna, fino al 31 gennaio per gli ordini di novembre e dicembre. Altri negozi: almeno 14 giorni, il diritto di recesso UE."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon: 30 giorns dalls consegns, fins al 31 gennais per gli ordins di novembrs e dicembrs. Altrs negozs: almens 14 giorns, il diritts di recesss UE."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon: 30 dagen na levering, tot 31 januari voor bestellingen in november en december. Andere winkels: minstens 14 dagen, het EU-herroepingsrecht."
          }
        }
      }
    },
