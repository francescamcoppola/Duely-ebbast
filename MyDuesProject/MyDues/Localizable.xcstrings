    "Your name, budget, currency, subscriptions and check-in answers are saved in the app's storage on this device. They're included in your device backup like other app data." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu nombre, presupuesto, moneda, suscripciones y respuestas de revisión se guardan en el almacenamiento de la app en este dispositivo. Se incluyen en la copia de seguridad del dispositivo como otros datos de apps."
          }
        }
      }
    },
    "Your name, budget, currency, subscriptions, payments, check-in answers, purchases and pagoPA notices are saved in the app's storage on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name, Budget, deine Währung, Abos, Zahlungen, Check-in-Antworten, Käufe und pagoPA-Zahlungsaufforderungen werden im Speicher der App auf diesem Gerät gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre, presupuesto, divisa, suscripciones, pagos, respuestas de check-in, compras y avisos pagoPA se guardan en el almacenamiento de la app en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom, budget, devise, abonnements, paiements, réponses aux check-ins, achats et avis pagoPA sont enregistrés dans le stockage de l'app sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome, budget, valuta, abbonamenti, pagamenti, risposte ai check-in, acquisti e avvisi pagoPA sono salvati nella memoria dell'app su questo dispositivo."
          }
        },
        "it-VA" : {
          "stringUnit" : {
