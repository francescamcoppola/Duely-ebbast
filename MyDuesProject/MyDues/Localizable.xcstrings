    "Opens %@'s own plans page to compare prices, then enter the one you pay for below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Tarifseite von %@, um Preise zu vergleichen; gib dann unten den Tarif ein, den du zahlst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la página de planes de %@ para comparar precios; luego introduce abajo el que pagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la page des formules de %@ pour comparer les prix, puis saisissez ci-dessous celle que vous payez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la pagina dei piani di %@ per confrontare i prezzi, poi inserisci qui sotto quello che paghi."
          }
