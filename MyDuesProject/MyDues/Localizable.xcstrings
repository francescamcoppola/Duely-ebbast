          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in voltooid"
          }
        }
      }
    },
    "Check-in, payment, return, warranty, trial and pagoPA reminders are scheduled on your device. iCloud only uses silent notifications to tell the app your data changed on another device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen für Check-ins, Zahlungen, Rücksendungen, Garantien, Testphasen und pagoPA werden auf deinem Gerät geplant. iCloud nutzt nur stille Mitteilungen, um der App zu melden, dass sich deine Daten auf einem anderen Gerät geändert haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de check-in, pagos, devoluciones, garantías, pruebas y avisos pagoPA se programan en tu dispositivo. iCloud solo usa notificaciones silenciosas para avisar a la app de que tus datos cambiaron en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels de check-in, de paiement, de retour, de garantie, d'essai et pagoPA sont programmés sur votre appareil. iCloud utilise seulement des notifications silencieuses pour signaler à l'app que vos données ont changé sur un autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria di check-in, pagamenti, resi, garanzie, prove gratuite e avvisi pagoPA sono programmati sul tuo dispositivo. iCloud usa solo notifiche silenziose per avvisare l'app che i dati sono cambiati su un altro dispositivo."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoris di check-in, pagaments, ress, garanzis, provs gratuits e avviss pagoPA sons programmats sul tuo dispositivs. iCloud usa sols notifichs silenzioss per avvisars l'app che i dats sons cambiats su un altrs dispositivs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen voor check-ins, betalingen, retouren, garanties, proefperiodes en pagoPA worden op je apparaat ingepland. iCloud gebruikt alleen stille meldingen om de app te laten weten dat je gegevens op een ander apparaat zijn gewijzigd."
          }
        }
      }
    },
