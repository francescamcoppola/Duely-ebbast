    "Each account's sign-in is stored in this device's Keychain and is never synced to iCloud. Disconnect at any time here or in your Google Account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung jedes Accounts wird im Schlüsselbund dieses Geräts gespeichert und nie mit iCloud synchronisiert. Trenne sie jederzeit hier oder in deinem Google-Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de cada cuenta se guarda en el llavero de este dispositivo y nunca se sincroniza con iCloud. Desconéctala cuando quieras aquí o en tu cuenta de Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion de chaque compte est stockée dans le trousseau de cet appareil et n'est jamais synchronisée avec iCloud. Déconnectez-la à tout moment ici ou dans votre compte Google."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso di ogni account è salvato nel Portachiavi di questo dispositivo e non viene mai sincronizzato con iCloud. Puoi scollegarlo quando vuoi da qui o dal tuo Account Google."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesss di ogns account è salvats nel Portachiavs di quests dispositivs e non viens mai sincronizzats con iCloud. Puoi scollegarls quands vuoi da qui o dal tuo Account Google."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmelding van elk account wordt bewaard in de sleutelhanger van dit apparaat en wordt nooit met iCloud gesynchroniseerd. Ontkoppel op elk moment hier of in je Google-account."
          }
        }
      }
    },
    "Each Gmail sign-in is kept in this device's Keychain and is never synced to iCloud. Disconnecting an account revokes it in your Google Account and deletes it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Gmail-Anmeldung liegt im Schlüsselbund dieses Geräts und wird nie mit iCloud synchronisiert. Beim Trennen eines Accounts wird der Zugriff in deinem Google-Konto widerrufen und gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inicio de sesión de Gmail se guarda en el llavero de este dispositivo y nunca se sincroniza con iCloud. Al desconectar una cuenta, el acceso se revoca en tu cuenta de Google y se elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque connexion Gmail est conservée dans le trousseau de cet appareil et n'est jamais synchronisée avec iCloud. Déconnecter un compte révoque l'accès dans votre compte Google et le supprime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni accesso Gmail è salvato nel Portachiavi di questo dispositivo e non viene mai sincronizzato con iCloud. Scollegando un account, l'accesso viene revocato nel tuo Account Google ed eliminato."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogns accesss Gmail è salvats nel Portachiavs di quests dispositivs e non viens mai sincronizzats con iCloud. Scollegands un account, l'accesss viens revocats nel tuo Account Google ed eliminats."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke Gmail-aanmelding staat in de sleutelhanger van dit apparaat en wordt nooit met iCloud gesynchroniseerd. Bij het ontkoppelen van een account wordt de toegang in je Google-account ingetrokken en verwijderd."
          }
        }
      }
    },
