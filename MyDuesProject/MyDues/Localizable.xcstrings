    "The first charge is on the day the trial ends. You get a reminder 2 days before, in time to cancel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Abbuchung ist am letzten Tag der Testphase. Du wirst 2 Tage vorher erinnert, rechtzeitig zum Kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer cargo es el día en que termina la prueba. Recibes un aviso 2 días antes, a tiempo para cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier prélèvement a lieu le jour de la fin de l'essai. Un rappel arrive 2 jours avant, à temps pour résilier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo addebito è il giorno in cui finisce la prova. Ricevi un promemoria 2 giorni prima, in tempo per disdire."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prims addebits è il giorns in cui finiscs la provs. Ricevs un promemoris 2 giorns prims, in temps per disdirs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste afschrijving is op de dag dat de proefperiode eindigt. Je krijgt 2 dagen vooraf een herinnering, op tijd om op te zeggen."
          }
        }
      }
    },
    "The Gmail sign-in is kept in this device's Keychain and isn't synced. Disconnecting revokes it in your Google Account and deletes it." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El inicio de sesión de Gmail se guarda en el llavero de este dispositivo y no se sincroniza. Al desconectarlo, se revoca en tu cuenta de Google y se elimina."
          }
        }
      }
    },
    "The legal warranty in the EU lasts 2 years from delivery." : {
      "localizations" : {
