      }
    },
    "Opens checkout.pagopa.it, pagoPA's official site, with this notice already filled in. Pay by card, PayPal, Satispay or your bank. The amount is checked again there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet checkout.pagopa.it, die offizielle pagoPA-Seite, mit dieser Zahlungsaufforderung. Bezahle per Karte, PayPal, Satispay oder über deine Bank. Der Betrag wird dort erneut geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre checkout.pagopa.it, el sitio oficial de pagoPA, con este aviso ya rellenado. Paga con tarjeta, PayPal, Satispay o tu banco. Allí se vuelve a comprobar el importe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre checkout.pagopa.it, le site officiel de pagoPA, avec cet avis déjà rempli. Payez par carte, PayPal, Satispay ou votre banque. Le montant y est vérifié à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre checkout.pagopa.it, il sito ufficiale pagoPA, con questo avviso già compilato. Paga con carta, PayPal, Satispay o la tua banca. L'importo viene verificato di nuovo lì."
          }
        },
        "it-VA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprs checkout.pagopa.it, il sits ufficials pagoPA, con quests avviss già compilats. Pags con carts, PayPal, Satispay o la tua bancs. L'imports viens verificats di nuovs lì."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent checkout.pagopa.it, de officiële site van pagoPA, met dit betaalbericht al ingevuld. Betaal met kaart, PayPal, Satispay of je bank. Het bedrag wordt daar opnieuw gecontroleerd."
          }
        }
      }
    },
